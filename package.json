{
  "name": "quizquake-brainstorm-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Computerized Adaptive Testing Arena with Real-time Difficulty Scaling & Weak-Topic Diagnostics",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx server/src/server.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/src/server.ts",
    "test:engine": "tsx server/src/test-adaptive.ts"
  },
  "dependencies": {
    "@types/sqlite3": "^3.1.11",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.4.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
